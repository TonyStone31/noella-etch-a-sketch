  object btnExport: TButton
    Left = 24
    Height = 32
    Top = 600
    Width = 236
    Caption = 'Export the submittal...'
    Hint = 'the system, the zone and loop schedules, every zone''s material list and notes, and the design record - how each zone was searched and what else it found'
    OnClick = btnExportClick
    ShowHint = True
    TabOrder = 22
  end
  object sdExport: TSaveDialog
    Title = 'Export the radiant submittal'
    DefaultExt = '.pdf'
    Filter = 'PDF (*.pdf)|*.pdf|Text (*.txt)|*.txt'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 72
    Top = 8
  end
  object btnReport: TButton
    Left = 280
    Height = 32
    Top = 550
    Width = 150
    Caption = 'Report a problem...'
    OnClick = btnReportClick
    TabOrder = 18
  end
  object pcRight: TPageControl
    Left = 480
    Height = 650
    Top = 112
    Width = 476
    ActivePage = tsPlan
    TabIndex = 0
    TabOrder = 19
    object tsPlan: TTabSheet
      Caption = 'Plan'
      ClientHeight = 652
      ClientWidth = 468
      object pbPlan: TPaintBox
        Left = 0
        Height = 652
        Top = 0
        Width = 468
        Align = alClient
        OnMouseDown = pbPlanMouseDown
        OnMouseMove = pbPlanMouseMove
        OnMouseUp = pbPlanMouseUp
        OnPaint = pbPlanPaint
        PopupMenu = pmZone
      end
    end
  end
  object tcZones: TTabControl
    Left = 976
    Height = 718
    Top = 44
    Width = 344
    OnChange = tcZonesChange
    TabOrder = 21
    object pnZone: TPanel
      Left = 0
      Height = 670
      Top = 0
      Width = 344
      Align = alClient
      BevelOuter = bvNone
      ClientHeight = 670
      ClientWidth = 344
      TabOrder = 0
      object lblZoneHead: TLabel
        Left = 8
        Height = 58
        Top = 8
        Width = 324
        AutoSize = False
        WordWrap = True
        Caption = ''
