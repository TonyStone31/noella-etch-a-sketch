object RadiantBusyForm: TRadiantBusyForm
  Left = 520
  Height = 170
  Top = 300
  Width = 520
  BorderIcons = []
  BorderStyle = bsDialog
  Caption = 'Searching for a layout'
  ClientHeight = 170
  ClientWidth = 520
  Position = poOwnerFormCenter
  OnShow = FormShow
  object lblStage: TLabel
    Left = 24
    Height = 26
    Top = 18
    Width = 472
    Anchors = [akTop, akLeft, akRight]
    AutoSize = False
    Caption = 'Searching'
    Font.Height = -17
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblDetail: TLabel
    Left = 24
    Height = 36
    Top = 48
    Width = 472
    Anchors = [akTop, akLeft, akRight]
    AutoSize = False
    WordWrap = True
  end
  object pbProgress: TProgressBar
    Left = 24
    Height = 22
    Top = 88
    Width = 472
    Anchors = [akTop, akLeft, akRight]
    Max = 100
    TabOrder = 0
  end
  object btnStopAll: TButton
    Left = 186
    Height = 32
    Top = 124
    Width = 100
    Anchors = [akRight, akBottom]
    Caption = 'Stop all'
    Hint = 'keep the best of this zone and search no more zones'
    OnClick = btnStopAllClick
    ShowHint = True
    TabOrder = 2
  end
  object btnStop: TButton
    Left = 296
    Height = 32
    Top = 124
    Width = 200
    Anchors = [akRight, akBottom]
    Cancel = True
    Caption = 'Stop - keep the best'
    Hint = 'keep the best layout of this zone so far and go on to the next zone'
    OnClick = btnStopClick
    ShowHint = True
    TabOrder = 1
  end
  object tmrStart: TTimer
    Enabled = False
    Interval = 30
    OnTimer = tmrStartTimer
    Left = 8
    Top = 124
  end
end
