object SpoolForm: TSpoolForm
  Left = 300
  Height = 740
  Top = 120
  Width = 1000
  BorderStyle = bsDialog
  Caption = 'Fitter''s scratchpad - pipe spool'
  ClientHeight = 740
  ClientWidth = 1000
  Position = poMainFormCenter
  OnCreate = FormCreate
  object lblTitle: TLabel
    Left = 16
    Height = 24
    Top = 12
    Width = 400
    Caption = 'Fitter''s scratchpad - the pipe iso'
    Font.Height = -16
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblHint: TLabel
    Left = 16
    Height = 36
    Top = 38
    Width = 968
    AutoSize = False
    Caption = 'Click where each leg ends - the paper snaps it to the three axes, Shift for a 45.  Type its length, say what it was measured between, Enter.  Click a leg to change it; right-click to take it out.'
    Font.Color = clGray
    ParentFont = False
    WordWrap = True
  end
  object lblSize: TLabel
    Left = 16
    Height = 18
    Top = 84
    Width = 80
    Caption = 'Pipe size'
  end
  object cbSize: TComboBox
    Left = 16
    Height = 28
    Top = 104
    Width = 120
    ItemHeight = 0
    OnChange = AnyChange
    Style = csDropDownList
    TabOrder = 0
  end
  object rgRadius: TRadioGroup
    Left = 16
    Height = 52
    Top = 140
    Width = 250
    AutoFill = True
    Caption = 'Elbows'
    ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
    ChildSizing.EnlargeVertical = crsHomogenousChildResize
    ChildSizing.ShrinkHorizontal = crsScaleChilds
    ChildSizing.ShrinkVertical = crsScaleChilds
    ChildSizing.Layout = cclLeftToRightThenTopToBottom
    ChildSizing.ControlsPerLine = 2
    Columns = 2
    ItemIndex = 0
    Items.Strings = (
      'Long radius'
      'Short radius'
    )
    OnClick = AnyChange
    TabOrder = 1
  end
  object lblEnd0: TLabel
    Left = 16
    Height = 18
    Top = 200
    Width = 80
    Caption = 'Start end'
  end
  object cbEnd0: TComboBox
    Left = 16
    Height = 28
    Top = 220
    Width = 250
    ItemHeight = 0
    OnChange = AnyChange
    Style = csDropDownList
    TabOrder = 2
  end
  object lblEnd1: TLabel
    Left = 16
    Height = 18
    Top = 254
    Width = 80
    Caption = 'Far end'
  end
  object cbEnd1: TComboBox
    Left = 16
    Height = 28
    Top = 274
    Width = 250
    ItemHeight = 0
    OnChange = AnyChange
    Style = csDropDownList
    TabOrder = 3
  end
  object lblLen: TLabel
    Left = 16
    Height = 18
    Top = 316
    Width = 200
    Caption = 'Length'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object edLen: TEdit
    Left = 16
    Height = 28
    Top = 336
    Width = 100
    OnKeyPress = edLenKeyPress
    TabOrder = 4
  end
  object lblLenUnit: TLabel
    Left = 122
    Height = 18
    Top = 342
    Width = 16
    Caption = 'in'
  end
  object cbMeasure: TComboBox
    Left = 16
    Height = 28
    Top = 370
    Width = 250
    ItemHeight = 0
    OnChange = MeasureChange
    Style = csDropDownList
    TabOrder = 16
  end
  object lblMeasureHint: TLabel
    Left = 16
    Height = 18
    Top = 400
    Width = 250
    Caption = 'end = the pipe end, flange face, or weld'
    Font.Color = clGray
    ParentFont = False
  end
  object btnLeg: TButton
    Left = 146
    Height = 30
    Top = 335
    Width = 120
    Caption = 'Set the length'
    OnClick = btnLegClick
    TabOrder = 5
  end
  object btnUndo: TButton
    Left = 16
    Height = 30
    Top = 422
    Width = 250
    Caption = 'Take this leg off'
    OnClick = btnUndoClick
    TabOrder = 6
  end
  object lblTag: TLabel
    Left = 16
    Height = 18
    Top = 460
    Width = 40
    Caption = 'Tag'
  end
  object edTag: TEdit
    Left = 16
    Height = 28
    Top = 480
    Width = 250
    OnChange = AnyChange
    TabOrder = 7
  end
  object cbDims: TCheckBox
    Left = 16
    Height = 22
    Top = 514
    Width = 250
    Caption = 'Put the lengths on it'
    Checked = True
    State = cbChecked
    OnChange = AnyChange
    TabOrder = 8
  end
  object memTicket: TMemo
    Left = 16
    Height = 106
    Top = 568
    Width = 250
    Font.Height = -11
    Font.Name = 'Monospace'
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssAutoVertical
    TabOrder = 9
  end
  object pcViews: TPageControl
    Left = 280
    Height = 596
    Top = 78
    Width = 704
    ActivePage = tsIso
    TabIndex = 0
    TabOrder = 10
    object tsIso: TTabSheet
      Caption = 'Iso sketch'
      ClientHeight = 562
      ClientWidth = 696
      object pbSketch: TPaintBox
        Left = 0
        Height = 562
        Top = 0
        Width = 696
        Align = alClient
        OnMouseDown = pbSketchMouseDown
        OnMouseMove = pbSketchMouseMove
        OnPaint = pbSketchPaint
      end
    end
    object ts3D: TTabSheet
      Caption = '3D'
      ClientHeight = 562
      ClientWidth = 696
      object pb3D: TPaintBox
        Left = 0
        Height = 562
        Top = 0
        Width = 696
        Align = alClient
        OnPaint = pb3DPaint
      end
    end
  end
  object lblStatus: TLabel
    Left = 280
    Height = 18
    Top = 680
    Width = 704
    AutoSize = False
    Caption = ''
  end
  object btnReport: TButton
    Left = 16
    Height = 32
    Top = 696
    Width = 150
    Caption = 'Report a problem...'
    OnClick = btnReportClick
    TabOrder = 11
  end
  object btnEmail: TButton
    Left = 480
    Height = 32
    Top = 696
    Width = 110
    Caption = 'Email it...'
    OnClick = btnEmailClick
    TabOrder = 12
  end
  object btnFiles: TButton
    Left = 596
    Height = 32
    Top = 696
    Width = 130
    Caption = 'Show the files'
    OnClick = btnFilesClick
    TabOrder = 13
  end
  object btnCancel: TButton
    Left = 734
    Height = 32
    Top = 696
    Width = 100
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 14
  end
  object btnBuild: TButton
    Left = 842
    Height = 32
    Top = 696
    Width = 142
    Caption = 'Build it'
    ModalResult = 1
    TabOrder = 15
  end
  object cbLines: TCheckBox
    Left = 16
    Height = 22
    Top = 538
    Width = 250
    Caption = 'Lined paper (off: dots)'
    Checked = True
    State = cbChecked
    OnChange = AnyChange
    TabOrder = 17
  end
end
