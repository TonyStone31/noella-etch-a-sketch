        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uSplash.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="SpoolForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uSysInfo.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="SpoolForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="uTouch.pas"/>
        <IsPartOfProject Value="True"/>
