procedure Jig0(L: TStrings);
begin
  L.Add('#!/usr/bin/env instantfpc');
  L.Add('{ A JIG: any program that prints Heck.  This one prints a star.');
  L.Add('  It is handed its values as  Name=value  - lengths as plain inches. }');
  L.Add('program star;');
  L.Add('{$mode objfpc}{$H+}');
  L.Add('uses SysUtils, Math;');
  L.Add('');
  L.Add('function Value(const Name: string; Default: Double): Double;');
  L.Add('var I: Integer; S: string;');
  L.Add('begin');
  L.Add('  Result := Default;');
  L.Add('  for I := 1 to ParamCount do');
  L.Add('  begin');
  L.Add('    S := ParamStr(I);');
  L.Add('    if SameText(Copy(S, 1, Length(Name) + 1), Name + ''='') then');
  L.Add('      Result := StrToFloatDef(Copy(S, Length(Name) + 2, 99), Default);');
  L.Add('  end;');
  L.Add('end;');
  L.Add('');
  L.Add('var');
  L.Add('  N, I: Integer;');
  L.Add('  R, E, No, A, Rad: Double;');
  L.Add('  X, Y: array of Double;');
  L.Add('begin');
  L.Add('  DefaultFormatSettings.DecimalSeparator := ''.'';');
  L.Add('  N  := Round(Value(''Points'', 5));');
  L.Add('  R  := Value(''Radius'', 24);');
  L.Add('  E  := Value(''East'', 0);');
  L.Add('  No := Value(''North'', 0);');
  L.Add('  SetLength(X, 2 * N);');
  L.Add('  SetLength(Y, 2 * N);');
  L.Add('  for I := 0 to 2 * N - 1 do');
  L.Add('  begin');
  L.Add('    if Odd(I) then Rad := R * 0.4 else Rad := R;');
  L.Add('    A := Pi / 2 + I * Pi / N;');
  L.Add('    X[I] := E + Rad * Cos(A);');
  L.Add('    Y[I] := No + Rad * Sin(A);');
  L.Add('  end;');
  L.Add('  for I := 0 to 2 * N - 1 do');
  L.Add('    WriteLn(Format(''line = %.4f" east, %.4f" north, 0 up to %.4f" east, %.4f" north, 0 up'',');
  L.Add('      [X[I], Y[I], X[(I + 1) mod (2 * N)], Y[(I + 1) mod (2 * N)]]));');
  L.Add('end.');
end;

procedure Jig1(L: TStrings);
begin
  L.Add('#!/usr/bin/env python3');
  L.Add('# A JIG: any program that prints Heck.  This one prints a balloon on a string.');
  L.Add('# It is handed its values as  Name=value  - lengths as plain inches.');
  L.Add('import sys, math');
  L.Add('');
  L.Add('v = dict(a.split("=", 1) for a in sys.argv[1:] if "=" in a)');
  L.Add('r = float(v.get("Radius", 18))');
  L.Add('e = float(v.get("East", 0))');
  L.Add('n = float(v.get("North", 0))');
  L.Add('h = float(v.get("Height", 72))');
  L.Add('');
  L.Add('# the balloon: a circle standing up, facing south');
  L.Add('print("circle")');
  L.Add('print(f"  center = {e}\" east, {n}\" north, {h}\" up")');
  L.Add('print(f"  radius = {r}\"")');
  L.Add('print("  facing = south")');
  L.Add('print("  ink = red")');
  L.Add('print("end")');
  L.Add('');
  L.Add('# the knot: a little triangle under it');
  L.Add('k = r / 8');
  L.Add('top = h - r');
  L.Add('print(f"line = {e}\" east, {n}\" north, {top}\" up to {e - k}\" east, {n}\" north, {top - k}\" up")');
  L.Add('print(f"line = {e - k}\" east, {n}\" north, {top - k}\" up to {e + k}\" east, {n}\" north, {top - k}\" up")');
  L.Add('print(f"line = {e + k}\" east, {n}\" north, {top - k}\" up to {e}\" east, {n}\" north, {top}\" up")');
  L.Add('');
  L.Add('# the string: a gentle wave down to the floor');
  L.Add('steps = 12');
  L.Add('x0, z0 = e, top - k');
  L.Add('for i in range(1, steps + 1):');
  L.Add('    z1 = (top - k) * (1 - i / steps)');
  L.Add('    x1 = e + math.sin(i * math.pi / 3) * r / 6');
  L.Add('    print(f"line = {x0:.4f}\" east, {n}\" north, {z0:.4f}\" up to {x1:.4f}\" east, {n}\" north, {z1:.4f}\" up")');
  L.Add('    x0, z0 = x1, z1');
end;

procedure Jig2(L: TStrings);
begin
  L.Add('#!/usr/bin/env perl');
  L.Add('# A JIG: any program that prints Heck.  This one prints a fence.');
  L.Add('# It is handed its values as  Name=value  - lengths as plain inches.');
  L.Add('use strict; use warnings;');
  L.Add('my %v = map { /^(\w+)=(.*)$/ ? ($1 => $2) : () } @ARGV;');
  L.Add('my $posts   = $v{Posts}   // 6;');
  L.Add('my $spacing = $v{Spacing} // 24;');
  L.Add('my $height  = $v{Height}  // 36;');
  L.Add('my $north   = $v{North}   // 0;');
  L.Add('my $east    = $v{East}    // 0;');
  L.Add('');
  L.Add('for my $i (0 .. $posts - 1) {');
  L.Add('    my $x = $east + $i * $spacing;');
  L.Add('    print qq{line = $x" east, $north" north, 0 up to + $height" up\n};');
  L.Add('}');
  L.Add('my $end = $east + ($posts - 1) * $spacing;');
  L.Add('for my $rail ($height * 0.3, $height * 0.8) {');
  L.Add('    print qq{line = $east" east, $north" north, $rail" up to $end" east, $north" north, $rail" up\n};');
  L.Add('}');
end;

procedure Jig3(L: TStrings);
begin
  L.Add('#!/bin/sh');
  L.Add('# A JIG: any program that prints Heck.  This one prints a flight of steps.');
  L.Add('# It is handed its values as  Name=value  - lengths as plain inches.');
  L.Add('# (steps.ps1 beside this is the same jig for a machine with PowerShell and');
  L.Add('# no shell; the program runs whichever suits the machine it is on.)');
  L.Add('awk -v args="$*" ''BEGIN {');
  L.Add('  n = split(args, A, " ")');
  L.Add('  for (i = 1; i <= n; i++) { split(A[i], kv, "="); v[kv[1]] = kv[2] }');
  L.Add('  steps = (v["Steps"] != "") ? v["Steps"] : 5');
  L.Add('  rise  = (v["Rise"]  != "") ? v["Rise"]  : 7.5');
  L.Add('  going = (v["Run"]   != "") ? v["Run"]   : 10');
  L.Add('  wide  = (v["Width"] != "") ? v["Width"] : 36');
  L.Add('  e     = (v["East"]  != "") ? v["East"]  : 0');
  L.Add('  no    = (v["North"] != "") ? v["North"] : 0');
  L.Add('  x = e; z = 0');
  L.Add('  for (side = 0; side <= 1; side++) {');
  L.Add('    y = no + side * wide; x = e; z = 0');
  L.Add('    for (i = 1; i <= steps; i++) {');
  L.Add('      printf "line = %g\" east, %g\" north, %g\" up to + %g\" up\n", x, y, z, rise');
  L.Add('      printf "line = %g\" east, %g\" north, %g\" up to + %g\" east\n", x, y, z + rise, going');
  L.Add('      x += going; z += rise');
  L.Add('    }');
  L.Add('  }');
  L.Add('  x = e; z = 0');
  L.Add('  printf "line = %g\" east, %g\" north, %g\" up to + %g\" north\n", x, no, z, wide');
  L.Add('  for (i = 1; i <= steps; i++) {');
  L.Add('    printf "line = %g\" east, %g\" north, %g\" up to + %g\" north\n", x, no, z + rise, wide');
  L.Add('    printf "line = %g\" east, %g\" north, %g\" up to + %g\" north\n", x + going, no, z + rise, wide');
  L.Add('    x += going; z += rise');
  L.Add('  }');
  L.Add('}''');
end;

procedure Jig4(L: TStrings);
begin
  L.Add('# A JIG: any program that prints Heck.  This one prints a flight of steps.');
  L.Add('# It is handed its values as  Name=value  - lengths as plain inches.');
  L.Add('# (steps.sh beside this is the same jig for a machine with a shell and no');
  L.Add('# PowerShell; the program runs whichever suits the machine it is on.)');
  L.Add('$v = @{}');
  L.Add('foreach ($a in $args) { if ($a -match ''^(\w+)=(.*)$'') { $v[$matches[1]] = $matches[2] } }');
  L.Add('function Val($name, $default) {');
  L.Add('  if ($v.ContainsKey($name)) { [double]::Parse($v[$name], [cultureinfo]::InvariantCulture) } else { $default }');
  L.Add('}');
  L.Add('function N($x) { ([double]$x).ToString(''0.####'', [cultureinfo]::InvariantCulture) }');
  L.Add('');
  L.Add('$steps = [int](Val ''Steps'' 5)');
  L.Add('$rise  = Val ''Rise'' 7.5');
  L.Add('$going = Val ''Run'' 10');
  L.Add('$wide  = Val ''Width'' 36');
  L.Add('$e     = Val ''East'' 0');
  L.Add('$no    = Val ''North'' 0');
  L.Add('');
  L.Add('foreach ($side in 0, 1) {');
  L.Add('  $y = $no + $side * $wide; $x = $e; $z = 0');
  L.Add('  for ($i = 1; $i -le $steps; $i++) {');
  L.Add('    "line = $(N $x)`" east, $(N $y)`" north, $(N $z)`" up to + $(N $rise)`" up"');
  L.Add('    "line = $(N $x)`" east, $(N $y)`" north, $(N ($z + $rise))`" up to + $(N $going)`" east"');
  L.Add('    $x += $going; $z += $rise');
  L.Add('  }');
  L.Add('}');
  L.Add('$x = $e; $z = 0');
  L.Add('"line = $(N $x)`" east, $(N $no)`" north, $(N $z)`" up to + $(N $wide)`" north"');
  L.Add('for ($i = 1; $i -le $steps; $i++) {');
  L.Add('  "line = $(N $x)`" east, $(N $no)`" north, $(N ($z + $rise))`" up to + $(N $wide)`" north"');
  L.Add('  "line = $(N ($x + $going))`" east, $(N $no)`" north, $(N ($z + $rise))`" up to + $(N $wide)`" north"');
  L.Add('  $x += $going; $z += $rise');
  L.Add('}');
end;

procedure Jig5(L: TStrings);
begin
  L.Add('#!/usr/bin/env python3');
  L.Add('# A JIG: any program that prints Heck.  This one prints a body to dress -');
  L.Add('# a mannequin, standing on the floor, facing south.');
  L.Add('#');
  L.Add('# It is handed its values as  Name=value  - lengths as plain inches.');
  L.Add('#');
  L.Add('#   Height   how tall, from the floor to the top of the head     (6'')');
  L.Add('#   Weight   in pounds - what makes the same height fuller or slighter (150)');
  L.Add('#   Bust, Waist, Hip');
  L.Add('#            those three measurements, round, when you have them; left');
  L.Add('#            out, they follow the height and the weight');
  L.Add('#   Sides    how many corners round each section                    (24)');
  L.Add('#   East, North');
  L.Add('#            where she stands');
  L.Add('#');
  L.Add('# There is no engine in this and no library: a body is a stack of ovals.');
  L.Add('# At each height that matters there is a width, a depth, and how far the');
  L.Add('# middle of the oval sits back from the line the body stands on; between');
  L.Add('# those the ovals are eased into one another, and a skin of triangles is');
  L.Add('# stretched over the lot.  Every edge is soft, so what shows is the shape');
  L.Add('# and not the mesh.  The numbers are a woman''s, six foot and a hundred and');
  L.Add('# fifty pounds - what a size chart calls a tall eight - and the other sizes');
  L.Add('# are scaled from her.  Her arms hang at her sides, palms in.');
  L.Add('import sys, math');
  L.Add('');
  L.Add('v = dict(a.split("=", 1) for a in sys.argv[1:] if "=" in a)');
  L.Add('def num(name, default):');
  L.Add('    try:');
  L.Add('        return float(v.get(name, default))');
  L.Add('    except ValueError:');
  L.Add('        return float(default)');
  L.Add('');
  L.Add('H = num("Height", 72.0)');
  L.Add('W = num("Weight", 150.0)');
  L.Add('N = max(8, int(num("Sides", 24)))');
  L.Add('E0 = num("East", 0.0)');
  L.Add('N0 = num("North", 0.0)');
  L.Add('');
  L.Add('# How much fuller or slighter than the woman the numbers are for.  Bulk');
  L.Add('# goes with the square of a girth and the height, so a girth scale is the');
  L.Add('# square root of the weight per inch of height, against hers.');
  L.Add('g = math.sqrt((W / 150.0) / (H / 72.0))');
  L.Add('# Height scales every level; hers is 72.');
  L.Add('s = H / 72.0');
  L.Add('');
  L.Add('# ---- the sections -------------------------------------------------------');
  L.Add('# (height as a share of the stature, width, depth, how far back the middle');
  L.Add('# of the oval sits - all inches at 72" - and which girth scale it takes)');
  L.Add('# The names after them are the ones a measuring tape knows.');
  L.Add('');
  L.Add('TORSO = [');
  L.Add('    (0.460, 14.0, 8.4, 0.0, "g"),   # where the legs join');
  L.Add('    (0.500, 14.2, 9.0, 0.0, "g"),');
  L.Add('    (0.530, 14.4, 9.4, 0.0, "g"),   # hip - the fullest');
  L.Add('    (0.565, 13.4, 8.8, 0.2, "g"),   # high hip');
  L.Add('    (0.600, 12.0, 8.0, 0.3, "g"),');
  L.Add('    (0.625, 10.6, 6.7, 0.3, "g"),   # waist');
  L.Add('    (0.660, 11.6, 7.6, 0.2, "g"),   # under the bust');
  L.Add('    (0.700, 12.4, 9.6, -0.5, "g"),  # bust');
  L.Add('    (0.735, 13.0, 8.6, 0.0, "g"),');
  L.Add('    (0.780, 14.2, 8.0, 0.2, "g"),   # the armpits');
  L.Add('    (0.810, 15.6, 6.4, 0.4, "h"),   # across the shoulders');
  L.Add('    (0.826, 12.0, 5.8, 0.5, "h"),   # where they slope');
  L.Add('    (0.836, 7.6, 5.2, 0.6, "h"),');
  L.Add('    (0.845, 4.6, 4.8, 0.8, "n"),    # the neck');
  L.Add('    (0.868, 4.4, 4.7, 0.8, "n"),    # under the chin');
  L.Add(']');
  L.Add('HEAD = [');
  L.Add('    (0.868, 4.4, 4.7, 0.8, "1"),');
  L.Add('    (0.884, 4.8, 5.6, 0.9, "1"),    # the jaw');
  L.Add('    (0.905, 5.6, 7.0, 0.8, "1"),');
  L.Add('    (0.935, 5.9, 7.5, 0.7, "1"),    # the eyes: the widest');
  L.Add('    (0.965, 5.7, 7.2, 0.6, "1"),');
  L.Add('    (0.985, 4.4, 5.6, 0.5, "1"),');
  L.Add('    (0.997, 2.0, 2.6, 0.4, "1"),');
  L.Add(']');
  L.Add('LEG = [');
  L.Add('    (0.000, 3.6, 9.6, -2.6, "f"),   # the sole: a shoe, near enough');
  L.Add('    (0.026, 3.4, 8.2, -1.8, "f"),');
  L.Add('    (0.042, 3.0, 4.0, -0.2, "f"),');
  L.Add('    (0.055, 2.8, 3.2, 0.0, "g"),    # the ankle');
  L.Add('    (0.120, 3.4, 3.9, 0.0, "g"),');
  L.Add('    (0.200, 4.2, 4.7, 0.2, "g"),    # the calf');
  L.Add('    (0.260, 3.8, 4.2, 0.0, "g"),');
  L.Add('    (0.285, 3.9, 4.4, 0.0, "g"),    # the knee');
  L.Add('    (0.340, 4.6, 5.0, 0.0, "g"),');
  L.Add('    (0.400, 5.6, 5.8, 0.0, "g"),');
  L.Add('    (0.450, 6.4, 7.0, 0.0, "g"),    # the thigh');
  L.Add('    (0.478, 6.6, 7.2, 0.0, "g"),');
  L.Add(']');
  L.Add('LEG_APART = 3.5          # each leg''s middle, east and west of the line');
  L.Add('# an arm hangs a little out from the side, so the sixth number is how far');
  L.Add('# from the middle its own middle is at that height');
  L.Add('ARM = [');
  L.Add('    (0.824, 1.6, 1.8, 0.5, "h", 6.6),   # the top of the shoulder');
  L.Add('    (0.815, 3.4, 3.6, 0.5, "g", 6.8),');
  L.Add('    (0.790, 3.8, 3.9, 0.5, "g", 7.0),   # the deltoid');
  L.Add('    (0.740, 3.4, 3.5, 0.5, "g", 7.4),   # the upper arm');
  L.Add('    (0.690, 3.0, 3.2, 0.5, "g", 7.8),');
  L.Add('    (0.660, 3.0, 3.4, 0.6, "g", 8.0),   # the elbow');
  L.Add('    (0.620, 3.0, 3.3, 0.5, "g", 8.4),   # the forearm');
  L.Add('    (0.560, 2.6, 2.7, 0.4, "g", 8.8),');
  L.Add('    (0.500, 1.7, 2.2, 0.3, "f", 9.1),   # the wrist');
  L.Add('    (0.480, 1.2, 3.0, 0.3, "f", 9.2),');
  L.Add('    (0.440, 1.1, 3.4, 0.3, "f", 9.4),   # the palm');
  L.Add('    (0.410, 1.0, 2.6, 0.3, "f", 9.5),   # the fingers');
  L.Add('    (0.387, 0.6, 1.0, 0.3, "f", 9.6),');
  L.Add(']');
  L.Add('');
  L.Add('# The three the tape measures, as the table has them, and as they were asked');
  L.Add('# for; a ratio for each, eased along the body between them.');
  L.Add('def girth(w, d):');
  L.Add('    a, b = w / 2, d / 2');
  L.Add('    h = ((a - b) / (a + b)) ** 2');
  L.Add('    return math.pi * (a + b) * (1 + 3 * h / (10 + math.sqrt(4 - 3 * h)))');
  L.Add('');
  L.Add('def wanted(name, level):');
  L.Add('    for (z, w, d, off, k) in TORSO:');
  L.Add('        if z == level:');
  L.Add('            have = girth(w * g, d * g)');
  L.Add('    ask = v.get(name)');
  L.Add('    if ask is None or ask == "":');
  L.Add('        return 1.0');
  L.Add('    try:');
  L.Add('        return float(ask) / have');
  L.Add('    except ValueError:');
  L.Add('        return 1.0');
  L.Add('');
  L.Add('R_HIP, R_WAIST, R_BUST = wanted("Hip", 0.530), wanted("Waist", 0.625), wanted("Bust", 0.700)');
  L.Add('');
  L.Add('def asked_ratio(z):');
  L.Add('    # below the hip the hip''s; hip to waist to bust eased; above the bust');
  L.Add('    # fading to nothing by the shoulders');
  L.Add('    if z <= 0.530: return R_HIP');
  L.Add('    if z <= 0.625: return R_HIP + (R_WAIST - R_HIP) * (z - 0.530) / (0.625 - 0.530)');
  L.Add('    if z <= 0.700: return R_WAIST + (R_BUST - R_WAIST) * (z - 0.625) / (0.700 - 0.625)');
  L.Add('    if z <= 0.810: return R_BUST + (1.0 - R_BUST) * (z - 0.700) / (0.810 - 0.700)');
  L.Add('    return 1.0');
  L.Add('');
  L.Add('def scale_of(kind, z):');
  L.Add('    if kind == "g": return g * asked_ratio(z)');
  L.Add('    if kind == "h": return math.sqrt(g)          # shoulders are bone, mostly');
  L.Add('    if kind == "n": return math.sqrt(g)');
  L.Add('    if kind == "f": return 1.0                    # a shoe is a shoe');
  L.Add('    return 1.0');
  L.Add('');
  L.Add('# ---- easing between the sections ----------------------------------------');
  L.Add('# A monotone cubic through the points: it passes through every number in');
  L.Add('# the table and never overshoots, so a waist stays a waist.');
  L.Add('def monotone(xs, ys):');
  L.Add('    n = len(xs)');
  L.Add('    d = [(ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]) for i in range(n - 1)]');
  L.Add('    m = [0.0] * n');
  L.Add('    m[0], m[-1] = d[0], d[-1]');
  L.Add('    for i in range(1, n - 1):');
  L.Add('        if d[i - 1] * d[i] <= 0:');
  L.Add('            m[i] = 0.0');
  L.Add('        else:');
  L.Add('            m[i] = (d[i - 1] + d[i]) / 2');
  L.Add('    for i in range(n - 1):');
  L.Add('        if d[i] == 0:');
  L.Add('            m[i] = m[i + 1] = 0.0');
  L.Add('        else:');
  L.Add('            a, b = m[i] / d[i], m[i + 1] / d[i]');
  L.Add('            t = a * a + b * b');
  L.Add('            if t > 9:');
  L.Add('                tau = 3 / math.sqrt(t)');
  L.Add('                m[i], m[i + 1] = tau * a * d[i], tau * b * d[i]');
  L.Add('    def at(x):');
  L.Add('        if x <= xs[0]: return ys[0]');
  L.Add('        if x >= xs[-1]: return ys[-1]');
  L.Add('        i = 0');
  L.Add('        while xs[i + 1] < x: i += 1');
  L.Add('        h = xs[i + 1] - xs[i]');
  L.Add('        t = (x - xs[i]) / h');
  L.Add('        t2, t3 = t * t, t * t * t');
  L.Add('        return ((2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * h * m[i] +');
  L.Add('                (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * h * m[i + 1])');
  L.Add('    return at');
  L.Add('');
  L.Add('def rings_of(table, step_in):');
  L.Add('    # the levels: every one in the table, and more between so that no gap');
  L.Add('    # is over step_in inches');
  L.Add('    table = [r if len(r) == 6 else r + (0.0,) for r in table]');
  L.Add('    zs = [z for (z, w, d, off, k, cx) in table]');
  L.Add('    ws = [w * scale_of(k, z) for (z, w, d, off, k, cx) in table]');
  L.Add('    ds = [d * scale_of(k, z) for (z, w, d, off, k, cx) in table]');
  L.Add('    os_ = [off * s for (z, w, d, off, k, cx) in table]');
  L.Add('    cs = [cx * s for (z, w, d, off, k, cx) in table]');
  L.Add('    fw, fd, fo, fc = monotone(zs, ws), monotone(zs, ds), monotone(zs, os_), monotone(zs, cs)');
  L.Add('    levels = []');
  L.Add('    for i in range(len(zs) - 1):');
  L.Add('        gap = (zs[i + 1] - zs[i]) * H');
  L.Add('        n = max(1, int(math.ceil(gap / step_in)))');
  L.Add('        for j in range(n):');
  L.Add('            levels.append(zs[i] + (zs[i + 1] - zs[i]) * j / n)');
  L.Add('    levels.append(zs[-1])');
  L.Add('    return [(z * H, fw(z), fd(z), fo(z), fc(z)) for z in levels]');
  L.Add('');
  L.Add('# ---- printing -------------------------------------------------------------');
  L.Add('out = []');
  L.Add('def say(line): out.append(line)');
  L.Add('');
  L.Add('def along(n, plus, minus):');
  L.Add('    # a length and its direction - Heck has west, not minus east');
  L.Add('    n = round(n, 3) + 0.0');
  L.Add('    return f''{abs(n):.3f}" {plus if n >= 0 else minus}''');
  L.Add('');
  L.Add('def place(x, y, z):');
  L.Add('    return f''{along(x, "east", "west")}, {along(y, "north", "south")}, {along(z, "up", "down")}''');
  L.Add('');
  L.Add('def ring_points(prefix, ring, side):');
  L.Add('    # side is which way the ring''s own middle is moved: 1 east, -1 west');
  L.Add('    z, w, d, off, cx = ring');
  L.Add('    names = []');
  L.Add('    for i in range(N):');
  L.Add('        a = 2 * math.pi * i / N');
  L.Add('        # anticlockwise seen from above, starting east');
  L.Add('        x = E0 + side * cx + w / 2 * math.cos(a)');
  L.Add('        y = N0 + off + d / 2 * math.sin(a)');
  L.Add('        nm = f"{prefix}{i + 1}"');
  L.Add('        say(f"    {nm} = {place(x, y, z)}")');
  L.Add('        names.append(nm)');
  L.Add('    return names');
  L.Add('');
  L.Add('faces, lines, open_rings, seen = [], [], [], set()');
  L.Add('def edge(a, b):');
  L.Add('    # each edge once, whichever face asked for it');
  L.Add('    if (b, a) not in seen and (a, b) not in seen:');
  L.Add('        seen.add((a, b))');
  L.Add('        lines.append((a, b))');
  L.Add('');
  L.Add('def wall(lo, hi):');
  L.Add('    # the skin between two rings, as triangles - the ovals differ, so a');
  L.Add('    # four-cornered piece would not lie flat.  Turned to face outward.');
  L.Add('    for i in range(N):');
  L.Add('        j = (i + 1) % N');
  L.Add('        faces.append((lo[i], lo[j], hi[j]))');
  L.Add('        faces.append((lo[i], hi[j], hi[i]))');
  L.Add('        edge(lo[i], lo[j])');
  L.Add('        edge(lo[i], hi[i])');
  L.Add('        edge(lo[i], hi[j])');
  L.Add('');
  L.Add('def cap(ring, up):');
  L.Add('    # a flat end: the ring''s own loop, turned to face up or down');
  L.Add('    names = list(ring) if up else list(reversed(ring))');
  L.Add('    faces.append(tuple(names))');
  L.Add('    for i in range(N):');
  L.Add('        edge(ring[i], ring[(i + 1) % N])');
  L.Add('    open_rings.remove(ring)');
  L.Add('');
  L.Add('def pole(ring, name, x, y, z):');
  L.Add('    say(f"    {name} = {place(x, y, z)}")');
  L.Add('    for i in range(N):');
  L.Add('        j = (i + 1) % N');
  L.Add('        faces.append((ring[i], ring[j], name))');
  L.Add('        edge(ring[i], ring[j])');
  L.Add('        edge(ring[i], name)');
  L.Add('');
  L.Add('say("solid")');
  L.Add('say("  paint = #E6DCCB")');
  L.Add('say("  points")');
  L.Add('');
  L.Add('# the torso, closed underneath where the legs go in');
  L.Add('torso = rings_of(TORSO, 2.0 * s)');
  L.Add('rings = [ring_points(f"t{k}p", r, 1) for k, r in enumerate(torso)]');
  L.Add('open_rings.extend(rings)');
  L.Add('cap(rings[0], up=False)');
  L.Add('for k in range(len(rings) - 1):');
  L.Add('    wall(rings[k], rings[k + 1])');
  L.Add('neck_top = rings[-1]');
  L.Add('');
  L.Add('# the head, sharing the ring under the chin, closed at the crown');
  L.Add('head = rings_of(HEAD, 1.2 * s)');
  L.Add('hrings = [neck_top] + [ring_points(f"h{k}p", r, 1) for k, r in enumerate(head[1:])]');
  L.Add('open_rings.extend(hrings[1:])');
  L.Add('for k in range(len(hrings) - 1):');
  L.Add('    wall(hrings[k], hrings[k + 1])');
  L.Add('crown = head[-1]');
  L.Add('pole(hrings[-1], "crown", E0, N0 + crown[3], H)');
  L.Add('');
  L.Add('# two legs, closed at the top, where they are inside the torso - a shell');
  L.Add('# with a gap in it is one that will not print');
  L.Add('LEG = [r + (LEG_APART,) for r in LEG]');
  L.Add('for side, sign in (("l", -1), ("r", 1)):');
  L.Add('    leg = rings_of(LEG, 2.0 * s)');
  L.Add('    lrings = [ring_points(f"{side}{k}p", r, sign) for k, r in enumerate(leg)]');
  L.Add('    open_rings.extend(lrings)');
  L.Add('    cap(lrings[0], up=False)');
  L.Add('    cap(lrings[-1], up=True)');
  L.Add('    for k in range(len(lrings) - 1):');
  L.Add('        wall(lrings[k], lrings[k + 1])');
  L.Add('');
  L.Add('# two arms, rounded off at the shoulder and at the fingertips');
  L.Add('for side, sign in (("a", -1), ("b", 1)):');
  L.Add('    arm = rings_of(ARM, 1.5 * s)');
  L.Add('    arings = [ring_points(f"{side}{k}p", r, sign) for k, r in enumerate(arm)]');
  L.Add('    open_rings.extend(arings)');
  L.Add('    for k in range(len(arings) - 1):');
  L.Add('        wall(arings[k], arings[k + 1])');
  L.Add('    top, tip = arm[0], arm[-1]');
  L.Add('    # a point above a ring faces out as the crown does; one below, the');
  L.Add('    # ring goes round the other way');
  L.Add('    pole(arings[0], f"{side}top", E0 + sign * top[4], N0 + top[3], top[0] + 0.6 * s)');
  L.Add('    pole(arings[-1][::-1], f"{side}tip", E0 + sign * tip[4], N0 + tip[3], tip[0] - 0.5 * s)');
  L.Add('');
  L.Add('say("  end")');
  L.Add('for f in faces:');
  L.Add('    say("  face = " + " ".join(f))');
  L.Add('# every ring is a closed, flat loop of lines, and a closed loop of lines is');
  L.Add('# a face unless the text says otherwise - and inside a body it is not');
  L.Add('for r in open_rings:');
  L.Add('    say("  noface = " + " ".join(r))');
  L.Add('for a, b in lines:');
  L.Add('    say("  line")');
  L.Add('    say(f"    points = {a} to {b}")');
  L.Add('    say("    soft = true")');
  L.Add('    say("  end")');
  L.Add('say("end")');
  L.Add('print("\n".join(out))');
end;

procedure JigFileLines(I: Integer; L: TStrings);
begin
  case I of
    0: Jig0(L);
    1: Jig1(L);
    2: Jig2(L);
    3: Jig3(L);
    4: Jig4(L);
    5: Jig5(L);
  end;
end;

end.
